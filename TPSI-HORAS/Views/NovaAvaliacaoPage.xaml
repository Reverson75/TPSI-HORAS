<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TPSI_HORAS.Models"
             xmlns:vm="clr-namespace:TPSI_HORAS.ViewModels"
             x:Class="TPSI_HORAS.Views.NovaAvaliacaoPage"
             x:DataType="vm:NovaAvaliacaoViewModel"
             Title="Nova avaliação">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="UC" FontAttributes="Bold" />
            <Picker Title="Escolhe a UC"
                    ItemsSource="{Binding Ucs}"
                    ItemDisplayBinding="{Binding Rotulo, x:DataType=models:UcResumo}"
                    SelectedItem="{Binding UcSelecionada}" />

            <Label Text="Tipo" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding Tipos}" SelectedIndex="{Binding TipoIndex}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Data" FontAttributes="Bold" />
                    <DatePicker Date="{Binding Data}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Hora" FontAttributes="Bold" />
                    <TimePicker Time="{Binding Hora}" />
                </VerticalStackLayout>
            </Grid>

            <Label Text="Lembrete" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding Lembretes}" SelectedIndex="{Binding LembreteIndex}" />

            <Label Text="Notas (opcional)" FontAttributes="Bold" />
            <Editor Text="{Binding Notas}"
                    MaxLength="200"
                    HeightRequest="90"
                    Placeholder="Ex.: matéria, sala..." />

            <Button Text="Guardar" Command="{Binding GuardarCommand}" />
            <Button Text="Cancelar" Command="{Binding CancelarCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>