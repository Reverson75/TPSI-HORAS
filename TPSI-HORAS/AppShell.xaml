<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TPSI_HORAS.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:TPSI_HORAS.Views"
    Title="TPSI Horas">

    <TabBar>
        <ShellContent
            Title="UCs"
            ContentTemplate="{DataTemplate views:UcsPage}"
            Route="ucs" />

        <ShellContent
            Title="Agenda"
            ContentTemplate="{DataTemplate views:AgendaPage}"
            Route="agenda" />

        <ShellContent
            Title="Notas"
            ContentTemplate="{DataTemplate views:NotasPage}"
            Route="notas" />
    </TabBar>
</Shell>